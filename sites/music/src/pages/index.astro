---
/**
 * Milkshake O'neil — stub. Shares the theme package so both sites read as
 * siblings, but the music side gets its own layout and content pass.
 *
 * TODO before this replaces the Wix site:
 *  - The old sample pack CTA pointed at ToneDen, which shut down in 2024.
 *    That link has been dead for ~2 years. Replace with Bandcamp, Gumroad,
 *    or an email-for-download flow.
 *  - Pull the hero and profile images off the current Wix site.
 *  - Releases list that grows, rather than a static bio.
 */
import "@duran/theme/tokens.css";
import "@duran/theme/base.css";

const links = [
  { label: "Spotify", href: "https://open.spotify.com/artist/4jsDAwTiXLfwp77EBqqHup" },
  { label: "Apple Music", href: "https://music.apple.com/us/artist/milkshake-oneil/1507854328" },
  { label: "YouTube", href: "https://youtube.com/duransound" },
  { label: "Instagram", href: "https://instagram.com/duransound/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Milkshake O'neil</title>
    <meta name="description" content="Making music since 2005. San Francisco." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Newsreader:opsz,wght@6..72,300;6..72,400&family=DM+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <main class="wrap stub">
      <span class="label">Placeholder — music site not yet built</span>
      <h1>Milkshake O'neil</h1>
      <p>Instrumental, hip hop, indie, lo-fi. San Francisco. Making music since 2005.</p>
      <div class="links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </main>
  </body>
</html>

<style>
  .stub { display: flex; flex-direction: column; gap: 1.15rem; padding-block: 5rem; }
  h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 0.95; letter-spacing: -0.035em; }
  p { max-width: 50ch; color: var(--ink-mid); }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-family: var(--f-mono); font-size: 0.875rem; }
  .links a { text-decoration: none; border-bottom: 1px solid var(--tally); }
</style>
