---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Rail from "../components/Rail.astro";
import Resume from "../components/Resume.astro";
import Kit from "../components/Kit.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Notes from "../components/Notes.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import EditMode from "../components/EditMode.astro";
import { site } from "../data/site";

// Real name in the title and in schema.org Person data. This does far more for
// "recruiter googles Ian Duran" than the domain string ever will.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  email: site.email,
  jobTitle: "Event Studio Manager",
  address: { "@type": "PostalAddress", addressLocality: "San Francisco", addressRegion: "CA" },
  sameAs: [site.linkedin],
};
---
<Base title={site.name} description={site.tagline}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
  <Rail />
  <Masthead />
  <main>
    <Resume />
    <CaseStudies />
    <Kit />
    <Notes />
    <Education />
    <Footer />
  </main>
  {import.meta.env.DEV && <EditMode />}
</Base>
