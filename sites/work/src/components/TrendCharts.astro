---
/**
 * Eight weeks of walkthroughs, as two charts on one shared x axis.
 *
 * Two charts rather than one with two scales: readiness is a score out of
 * 100, the status mix is a count of rooms, and putting both on one plot would
 * need two y axes. The last week is always worked out from the rooms, so the
 * right-hand end of both charts can't disagree with the room tiles.
 *
 * Every point and segment carries a native tooltip, and the whole thing is
 * also a table behind "Show as a table" — colour is never the only way in.
 */
interface W { week: number; readiness: number; down: number; watch: number; ready: number; walked: number; current: boolean }
interface Props { weeks: W[]; target: number; total: number; caption: string; editAddr?: string }
const { weeks, target, total, caption, editAddr } = Astro.props;

const W = 640, L = 44, R = 70;
const n = weeks.length;
const x = (i: number) => L + (n === 1 ? 0 : (i * (W - L - R)) / (n - 1));

// readiness line
const H1 = 196, T1 = 14, B1 = 30;
const low = Math.min(60, Math.floor(Math.min(...weeks.map((w) => w.readiness)) / 10) * 10);
const y1 = (v: number) => T1 + ((100 - v) / (100 - low)) * (H1 - T1 - B1);
const ticks: number[] = [];
for (let v = low; v <= 100; v += 10) ticks.push(v);
const line = weeks.map((w, i) => `${x(i).toFixed(1)},${y1(w.readiness).toFixed(1)}`).join(" ");
const last = weeks[n - 1]!;

// status mix
const H2 = 178, T2 = 10, B2 = 30, BAR = 34, GAP = 2;
const plot2 = H2 - T2 - B2;
const hPer = plot2 / total;
const segs = weeks.map((w, i) => {
  let top = H2 - B2;
  return (["down", "watch", "ready"] as const).map((k) => {
    const h = w[k] * hPer;
    const seg = { k, v: w[k], x: x(i) - BAR / 2, y: top - h, h: Math.max(0, h - GAP) };
    top -= h;
    return seg;
  });
});
const word = { down: "Down", watch: "Watch", ready: "Ready" } as const;
---
<div class="trend">
  <figure class="diagram">
    <svg viewBox={`0 0 ${W} ${H1}`} role="img"
      aria-label={`Readiness by week: ${weeks.map((w) => `week ${w.week} ${w.readiness}`).join(", ")}. Target ${target}.`}>
      {ticks.map((v) => (
        <g>
          <line x1={L} x2={W - R} y1={y1(v)} y2={y1(v)} stroke="var(--draft-rule)" stroke-width="0.5" />
          <text class="ax" x={L - 8} y={y1(v) + 3.5} text-anchor="end">{v}</text>
        </g>
      ))}
      <line x1={L} x2={W - R} y1={y1(target)} y2={y1(target)} stroke="var(--draft-accent)" stroke-width="1.2" stroke-dasharray="5 4" />
      <text class="tg" x={W - R + 8} y={y1(target) + 3.5}>TARGET {target}</text>
      <polyline points={line} fill="none" stroke="var(--draft-ink)" stroke-width="2" stroke-linejoin="round" />
      {weeks.map((w, i) => (
        <circle cx={x(i)} cy={y1(w.readiness)} r={w.current ? 5 : 3.5} fill="var(--draft-ink)" stroke="var(--surface)" stroke-width="2">
          <title>{`Week ${w.week}${w.current ? " (this week)" : ""}: readiness ${w.readiness}`}</title>
        </circle>
      ))}
      <text class="end" x={x(n - 1) + 10} y={y1(last.readiness) + 4}>{last.readiness}</text>
      {weeks.map((w, i) => (
        <text class={`ax${w.current ? " now" : ""}`} x={x(i)} y={H1 - 10} text-anchor="middle">{w.current ? "NOW" : `W${w.week}`}</text>
      ))}
    </svg>
    <p class="cap label">Readiness score</p>
  </figure>

  <figure class="diagram">
    <svg viewBox={`0 0 ${W} ${H2}`} role="img"
      aria-label={`Rooms by status each week: ${weeks.map((w) => `week ${w.week} ${w.down} down, ${w.watch} watch, ${w.ready} ready`).join("; ")}.`}>
      <line x1={L} x2={W - R} y1={H2 - B2} y2={H2 - B2} stroke="var(--draft-rule)" stroke-width="1" />
      {segs.map((col, i) => col.map((s) => s.v > 0 && (
        <g>
          <rect x={s.x} y={s.y} width={BAR} height={s.h} class={`sg ${s.k}`}>
            <title>{`Week ${weeks[i]!.week}: ${s.v} ${word[s.k].toLowerCase()}`}</title>
          </rect>
          {s.h >= 13 && <text class={`sv ${s.k}`} x={s.x + BAR / 2} y={s.y + s.h / 2 + 3.5} text-anchor="middle">{s.v}</text>}
        </g>
      )))}
      {weeks.map((w, i) => (
        <text class={`ax${w.current ? " now" : ""}`} x={x(i)} y={H2 - 10} text-anchor="middle">{w.current ? "NOW" : `W${w.week}`}</text>
      ))}
    </svg>
    <div class="legend">
      <span class="label">Rooms by status</span>
      <span><i class="k down"></i>■ Down</span>
      <span><i class="k watch"></i>▲ Watch</span>
      <span><i class="k ready"></i>● Ready</span>
    </div>
  </figure>

  <p class="caption" data-edit={editAddr} data-mode={editAddr ? "inline" : undefined} set:html={caption} />

  <details class="as-table">
    <summary class="label">Show as a table</summary>
    <div class="tw">
      <table>
        <thead><tr><th>Week</th><th class="r">Readiness</th><th class="r">Down</th><th class="r">Watch</th><th class="r">Ready</th><th class="r">Walked</th></tr></thead>
        <tbody>
          {weeks.map((w) => (
            <tr>
              <td class="mono">{w.current ? `${w.week} · this week` : w.week}</td>
              <td class="r mono">{w.readiness}</td><td class="r mono">{w.down}</td>
              <td class="r mono">{w.watch}</td><td class="r mono">{w.ready}</td>
              <td class="r mono">{w.walked} / {total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<style>
  .trend { display: flex; flex-direction: column; gap: var(--plate-gap); }
  .diagram { margin: 0; background: var(--draft); border: var(--lw-thin) solid var(--draft-ink); padding: clamp(0.75rem, 2vw, 1.1rem); }
  svg { display: block; width: 100%; height: auto; }
  .ax { font-family: var(--f-mono); font-weight: 500; font-size: 10px; letter-spacing: 0.06em; fill: var(--draft-mid); }
  .ax.now { fill: var(--draft-ink); }
  .tg { font-family: var(--f-mono); font-weight: 500; font-size: 9.5px; letter-spacing: 0.1em; fill: var(--draft-accent); }
  .end { font-family: var(--f-mono); font-weight: 500; font-size: 13px; fill: var(--draft-ink); font-variant-numeric: tabular-nums; }
  .sg.down { fill: var(--tally); }
  .sg.watch { fill: var(--tally-wash); stroke: var(--tally); stroke-width: 1; }
  .sg.ready { fill: var(--held); }
  .sv { font-family: var(--f-mono); font-weight: 500; font-size: 10px; }
  .sv.down, .sv.ready { fill: var(--paper); }
  .sv.watch { fill: var(--draft-ink); }
  .cap { margin: 0.5rem 0 0; color: var(--ink-mid); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; align-items: center; margin-top: 0.55rem;
    font-family: var(--f-mono); font-weight: 500; font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mid); }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .k { width: 10px; height: 10px; display: inline-block; }
  .k.down { background: var(--tally); }
  .k.watch { background: var(--tally-wash); box-shadow: inset 0 0 0 1px var(--tally); }
  .k.ready { background: var(--held); }
  .caption { margin: 0; color: var(--ink-mid); max-width: 64ch; }
  .as-table summary { cursor: pointer; color: var(--ink-mid); }
  .as-table .tw { margin-top: 0.6rem; overflow-x: auto; border: var(--lw-thin) solid var(--ink); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; min-width: 28rem; font-size: 0.875rem; }
  th { font-family: var(--f-mono); font-weight: 500; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-mid); text-align: left; padding: 0.5rem 0.7rem; border-bottom: var(--lw-med) solid var(--ink); }
  td { padding: 0.4rem 0.7rem; border-bottom: var(--lw-hair) solid var(--rule); }
  tr:last-child td { border-bottom: 0; }
  .r { text-align: right; }
  .mono { font-family: var(--f-mono); font-weight: 500; font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
</style>
