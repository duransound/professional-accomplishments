---
import { education } from "../data/experience";
import { ed } from "../edit/attrs";
---
<section class="section" id="education">
  <div class="wrap section-grid">
    <div class="label">Education</div>
    <div class="section-body">
      <div>
        <h3 {...ed("experience.yaml", "education.degree")}>{education.degree}</h3>
        <span class="org" {...ed("experience.yaml", "education.school")}>{education.school}</span>
        {education.note && <p class="note-line" {...ed("experience.yaml", "education.note")}>{education.note}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .org {
    font-family: var(--f-mono); font-weight: 500; font-size: 0.75rem;
    color: var(--tally); letter-spacing: 0.08em; text-transform: uppercase;
    display: block; margin-top: 0.3rem;
  }
  .note-line { margin-top: 0.65rem; color: var(--ink-mid); font-size: 0.9688rem; max-width: 62ch; }
</style>
