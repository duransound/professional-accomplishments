---
/**
 * The crew map as a transit diagram. Departments are lines, seats are
 * stations, and every line terminates at ON AIR because that is genuinely
 * what they all feed.
 *
 * Geometry is COMPUTED from the data in crew.ts — station spacing, line
 * bends and the label ladder all derive from array position. Adding a seat
 * moves the diagram correctly instead of requiring hand-edited coordinates.
 *
 * Solid station = seat held. Dashed = worked alongside. That distinction is
 * the argument this section exists to make, so it is carried by the drawing
 * rather than by a legend the reader has to consult.
 */
import {
  depts, allSeats, statusLabel, defaultSeat, seatCount, crewPage,
  visibilityLabel, visibilityCount, zoneById, showZones, seatsByZone, programSeats,
  zones, crewLabels as L, crewText,
} from "../data/crew";
import ZonePlan from "./ZonePlan.astro";
import { ed } from "../edit/attrs";

const DEV = import.meta.env.DEV;
const zp = (id: string, field: string) => ed("crew.yaml", `zones.${zones.findIndex((z) => z.id === id)}.${field}`);
const lb = (key: string) => ed("crew.yaml", `page.labels.${key}`);
const mark = { immediate: "●", delayed: "▲", invisible: "■" } as const;

// Where each seat sits in crew.yaml, so its text can be edited in place.
const seatPath = new Map(depts.flatMap((d, i) => d.seats.map((s, j) => [s.id, `departments.${i}.seats.${j}`] as const)));
const sp = (id: string, field: string) => ed("crew.yaml", `${seatPath.get(id)}.${field}`);

const VB = { w: 1040, h: 505 };
const TERM = { x: 950, y: 300, r: 26 };
const LINE_Y = [140, 240, 350, 460];
const START_X = 185;
const SPACING = 128;   // > the horizontal reach of the longest 40-degree label
const ORIGIN_X = 145;
const LBL_X = 125;     // line names sit in their own column, right-aligned

const lines = depts.map((dept, i) => {
  const y = LINE_Y[i] ?? LINE_Y[LINE_Y.length - 1]! + (i - LINE_Y.length + 1) * 110;
  const stations = dept.seats.map((seat, j) => ({ seat, x: START_X + j * SPACING, y }));
  const lastX = stations[stations.length - 1]!.x;
  // 45-degree run into the terminus, pushed out if stations would collide with it.
  const bendX = Math.max(TERM.x - Math.abs(TERM.y - y), lastX + 50);
  return {
    dept,
    y,
    stations,
    path: `M${ORIGIN_X} ${y} H${bendX} L${TERM.x} ${TERM.y}`,
  };
});

---
<section class="section" id="crew">
  <div class="wrap section-grid">
    <div class="label">Crew map</div>
    <div class="section-body">
      <p class="intro" {...ed("crew.yaml", "page.intro")}>{crewPage.intro}</p>

      <p class="tallyline" {...ed("crew.yaml", "page.tally")} set:html={crewText(crewPage.tally, DEV)} />

      <figure class="diagram">
        {/* The switch is revealed by the script; without JavaScript the
            room view simply shows on its own. */}
        <div class="views" id="views" hidden>
          <span class="label" id="views-label" {...lb("groupSeats")}>{L.groupSeats}</span>
          <div class="views-row" role="group" aria-labelledby="views-label">
            <button type="button" class="plate-btn" data-view-btn="room" aria-pressed="true"><span {...lb("byRoom")}>{L.byRoom}</span></button>
            <button type="button" class="plate-btn" data-view-btn="dept" aria-pressed="false"><span {...lb("byDepartment")}>{L.byDepartment}</span></button>
          </div>
        </div>

        <div data-view="room">
          <ZonePlan />
          <div class="legend">
            {(["immediate", "delayed", "invisible"] as const).map((v) => (
              <span><i class={`vk ${v}`} aria-hidden="true">{mark[v]}</i><span {...ed("crew.yaml", `page.visibility.${v}`)}>{visibilityLabel[v]}</span> · {visibilityCount[v]}</span>
            ))}
            <span class="lg-sep" aria-hidden="true"></span>
            <span {...lb("solidHollow")}>{L.solidHollow}</span>
            <span>* <span {...lb("contestedKey")}>{L.contestedKey}</span></span>
          </div>
        </div>

        <div data-view="dept" hidden>
        <div class="scroller">
          <svg
            viewBox={`0 0 ${VB.w} ${VB.h}`}
            role="img"
            aria-label="Transit-style diagram of a live production crew. Each department is a line, each seat a station, all terminating at On Air."
          >
            <defs>
              {/* 50% ben-day dot. A dot means PARTIAL — here, a seat worked
                  alongside but never held. It is a value in crew.yaml. */}
              <pattern id="benday" width="4" height="4" patternUnits="userSpaceOnUse">
                <circle cx="1.2" cy="1.2" r="1.05" fill="var(--draft-mid)" />
              </pattern>
            </defs>

            {lines.map((l) => (
              <path class="rt" d={l.path} style={`stroke:${l.dept.color}`} />
            ))}

            <circle class="term-ring" cx={TERM.x} cy={TERM.y} r={TERM.r} />
            <circle class="term-core" cx={TERM.x} cy={TERM.y} r="9" />
            <text class="term-lbl" x={TERM.x} y={TERM.y + 52} text-anchor="middle">ON AIR</text>

            {lines.map((l) => (
              <text
                class="line-lbl" x={LBL_X} y={l.y} dy="0.34em" text-anchor="end"
              >{l.dept.short}</text>
            ))}

            {lines.map((l) =>
              l.stations.map(({ seat, x, y }) => (
                <g
                  class="station"
                  data-seat={seat.id}
                  data-selected={seat.id === defaultSeat ? "" : null}
                  role="button"
                  tabindex="0"
                  aria-label={`${seat.title} — ${statusLabel[seat.status]}. Reads as ${seat["reads-title"]}.`}
                >
                  <circle class="hit" cx={x} cy={y} r="18" />
                  <circle class="halo" cx={x} cy={y} r="14" />
                  {seat.status === "adjacent" ? (
                    <circle class="st-adj" cx={x} cy={y} r="8" />
                  ) : (
                    <>
                      <circle class="st-held" cx={x} cy={y} r="8" />
                      <circle class="st-core" cx={x} cy={y} r="3.2" />
                    </>
                  )}
                  {/* Both vocabularies are rendered; CSS shows one. That keeps
                      the production labels correct with JavaScript off, and
                      means the switch never has to rewrite the drawing. */}
                  <text class="st-lbl v-prod" x={x} y={y - 14} transform={`rotate(-40 ${x} ${y - 14})`}>
                    {seat.short}
                  </text>
                  <text class="st-lbl v-tech" x={x} y={y - 14} transform={`rotate(-40 ${x} ${y - 14})`}>
                    {seat["reads-title"]}
                  </text>
                </g>
              ))
            )}
          </svg>
        </div>

        <figcaption class="legend">
          {depts.map((d, i) => (
            <span><span class="lg-bar" style={`background:${d.color}`}></span><span {...ed("crew.yaml", `departments.${i}.short`)}>{d.short}</span></span>
          ))}
          <span class="lg-sep" aria-hidden="true"></span>
          <span>
            <svg width="16" height="16" aria-hidden="true" class="lg-ico">
              <circle cx="8" cy="8" r="6" class="st-held" /><circle cx="8" cy="8" r="2.4" class="st-core" />
            </svg><span {...lb("seatHeld")}>{L.seatHeld}</span>
          </span>
          <span>
            <svg width="16" height="16" aria-hidden="true" class="lg-ico">
              <circle cx="8" cy="8" r="6" class="st-adj" />
            </svg><span {...lb("workedAlongside")}>{L.workedAlongside}</span>
          </span>
        </figcaption>
        </div>
      </figure>

      <p class="thesis" {...ed("crew.yaml", "page.thesis")} set:html={crewText(crewPage.thesis, DEV)} />

      <details class="key">
        <summary class="label"><span {...lb("zoneKey")}>{L.zoneKey}</span></summary>
        <dl>
          {zones.filter((z) => z.kind !== "program" || (seatsByZone.get(z.id) ?? []).length).map((z) => ({ z, seats: seatsByZone.get(z.id) ?? [] })).map(({ z, seats }) => (
            <div>
              <dt {...zp(z.id, "name")}>{z.name}</dt>
              <dd>
                <span class="key-what" {...zp(z.id, "perceives")}>{z.perceives}</span>
                {seats.length ? (
                  <span class="key-seats">
                    {seats.map((st) => (
                      <span><b>{st.id.toUpperCase()}</b> <span class="v-prod" {...sp(st.id, "title")}>{st.title}</span><span class="v-tech" {...sp(st.id, "reads-title")}>{st["reads-title"]}</span></span>
                    ))}
                  </span>
                ) : <span class="key-empty" {...lb("noSeat")}>{L.noSeat}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </details>

      <div class="detail" aria-live="polite">
        {allSeats.map((s) => (
          <div data-seat-panel={s.id} hidden={s.id !== defaultSeat} class="panel">
            <div class="detail-head">
              <h3><span class="v-prod" {...sp(s.id, "title")}>{s.title}</span><span class="v-tech" {...sp(s.id, "reads-title")}>{s["reads-title"]}</span></h3>
              <span class="state" data-s={s.status} {...ed("crew.yaml", `page.status.${s.status}`)}>{statusLabel[s.status]}</span>
            </div>
            <p class="detail-what" {...sp(s.id, "what")}>{s.what}</p>
            <dl class="xlate">
              <dt {...lb("inTheRoom")}>{L.inTheRoom}</dt><dd {...sp(s.id, "room")}>{s.room}</dd>
              <dt {...lb("where")}>{L.where}</dt>
              <dd>
                <span {...zp(s.zone, "name")}>{zoneById.get(s.zone)?.name}</span>
                {zoneById.get(s.zone)?.kind === "program" && <> — <span {...lb("noShowDaySeat")}>{L.noShowDaySeat}</span></>}
              </dd>
              <dt {...lb("ifEmpty")}>{L.ifEmpty}</dt>
              <dd>
                <span class={`vis ${s.visibility}`}><i aria-hidden="true">{mark[s.visibility]}</i><span {...ed("crew.yaml", `page.visibility.${s.visibility}`)}>{visibilityLabel[s.visibility]}</span></span>
                <span class="conseq" {...sp(s.id, "consequence")}>{s.consequence}</span>
              </dd>
              {s.contested && <><dt {...lb("contested")}>{L.contested}</dt><dd {...sp(s.id, "contested")}>{s.contested}</dd></>}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Room / department switch. Both drawings are already on the page; this
  // only flips which one shows. Selection is shared across the two.
  const viewBar = document.getElementById("views");
  const viewBtns = document.querySelectorAll<HTMLButtonElement>("[data-view-btn]");
  const views = document.querySelectorAll<HTMLElement>("[data-view]");
  if (viewBar) viewBar.hidden = false;
  viewBtns.forEach((b) => b.addEventListener("click", () => {
    views.forEach((v) => { v.hidden = v.dataset.view !== b.dataset.viewBtn; });
    viewBtns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  }));

  const stations = document.querySelectorAll<SVGGElement>(".station");
  const panels = document.querySelectorAll<HTMLElement>("[data-seat-panel]");

  function select(id: string) {
    panels.forEach((p) => { p.hidden = p.dataset.seatPanel !== id; });
    stations.forEach((s) => {
      if (s.dataset.seat === id) s.dataset.selected = "";
      else delete s.dataset.selected;
    });
  }

  stations.forEach((s) => {
    const id = s.dataset.seat!;
    s.addEventListener("click", () => select(id));
    s.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(id); }
    });
  });
</script>

<style>
  .intro { color: var(--ink-mid); max-width: 62ch; }

  .tallyline {
    font-size: 1.1875rem; line-height: 1.5;
    max-width: 54ch; color: var(--ink);
    padding-left: 1.15rem; border-left: var(--lw-key) solid var(--tally);
  }
  .tallyline strong { font-weight: 500; box-shadow: inset 0 -0.4em 0 var(--tally-wash); }

  /* The drawing is the widest thing on the page, so it reclaims the label
     rail rather than being squeezed into the text column — otherwise the
     terminus falls outside the visible area on a laptop. On a phone it
     bleeds to the sheet border instead. */
  .diagram {
    position: relative; z-index: 1;
    margin: 0 calc(-1 * var(--plate-pad));
    border-block: var(--lw-key) solid var(--draft-ink);
    background: var(--draft);
  }
  @media (min-width: 48.0625rem) {
    .diagram {
      margin: 0;
      margin-left: calc(-1 * (var(--rail) + 3rem));
      width: calc(100% + var(--rail) + 3rem);
      border: var(--lw-key) solid var(--draft-ink);
    }
  }
  .scroller { overflow-x: auto; }
  .scroller > svg { display: block; width: 100%; min-width: 840px; height: auto; }

  .rt { fill: none; stroke-width: 9; stroke-linecap: butt; stroke-linejoin: miter; }

  .term-ring { fill: var(--draft); stroke: var(--draft-ink); stroke-width: 4; }
  .term-core { fill: var(--draft-accent); }
  .term-lbl {
    font-family: var(--f-display); font-size: 15px; font-weight: 700;
    letter-spacing: 0.1em; fill: var(--draft-ink);
  }

  /* Set in keyline black, never in the department colour: Video is amber,
     2.17:1 on stock, and fails as text at any size. The 9 px route stroke
     starts 20 px to the right and carries the colour instead. */
  .line-lbl {
    font-family: var(--f-display); font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; fill: var(--draft-ink);
  }

  .station { cursor: pointer; }
  .hit { fill: transparent; }
  .halo { fill: transparent; transition: fill 90ms linear; }
  .station:hover .halo { fill: var(--draft-wash); }
  .station[data-selected] .halo { fill: var(--draft-wash); stroke: var(--draft-accent); stroke-width: 2; }
  .station:focus-visible { outline: none; }
  .station:focus-visible .halo { fill: var(--draft-wash); stroke: var(--focus); stroke-width: 2.5; }

  /* Object keyline weight, 2.5 px, on every station. */
  .st-held { fill: var(--draft); stroke: var(--draft-ink); stroke-width: 2.5; }
  .st-core { fill: var(--draft-ink); }
  .st-adj  {
    fill: url(#benday); stroke: var(--draft-ink);
    stroke-width: 1.5; stroke-dasharray: 3.4 2.6;
  }

  /* The label is part of the target. People aim at the name, not the dot. */
  .st-lbl {
    font-family: var(--f-mono); font-weight: 500; font-size: 10px;
    fill: var(--draft-ink); letter-spacing: 0.04em; text-transform: uppercase;
  }
  .station[data-selected] .st-lbl { fill: var(--draft-accent); }

  .views {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem;
    padding: 0.75rem 1rem; border-bottom: var(--lw-key) solid var(--draft-ink);
    background: var(--draft-panel);
  }
  .views[hidden] { display: none; }
  .views .label { color: var(--ink-mid); }
  .views-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .views .plate-btn[aria-pressed="true"] { background: var(--tally); color: var(--paper); }

  .vk { font-style: normal; font-size: 0.75rem; line-height: 1; }
  .vk.immediate { color: var(--held); }
  .vk.delayed { color: var(--tally); }
  .vk.invisible { color: var(--tally); }

  .thesis {
    font-size: 1.0625rem; line-height: 1.55; max-width: 60ch; color: var(--ink-mid);
  }
  .thesis strong { color: var(--ink); font-weight: 500; box-shadow: inset 0 -0.4em 0 var(--tally-wash); }

  .key > summary { cursor: pointer; color: var(--ink-mid); }
  .key[open] > summary { color: var(--ink); margin-bottom: 0.8rem; }
  .key dl { margin: 0; display: flex; flex-direction: column; border-top: var(--lw-thin) solid var(--rule); }
  .key dl > div {
    display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 0.3rem 1.25rem;
    padding: 0.75rem 0; border-bottom: var(--lw-thin) solid var(--rule);
  }
  .key dt {
    font-family: var(--f-mono); font-weight: 500; font-size: 0.6875rem;
    letter-spacing: 0.13em; text-transform: uppercase; padding-top: 0.15rem;
  }
  .key dd { margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .key-what { color: var(--ink-mid); font-size: 0.9375rem; }
  .key-seats { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.9375rem; }
  .key-seats b { font-family: var(--f-mono); font-weight: 500; font-size: 0.75rem; }
  .key-empty { font-family: var(--f-mono); font-weight: 500; font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tally); }
  @media (max-width: 34rem) { .key dl > div { grid-template-columns: 1fr; } }

  .vis {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 0.5rem;
    font-family: var(--f-mono); font-weight: 500; font-size: 0.625rem;
    letter-spacing: 0.1em; text-transform: uppercase; padding: 0.12rem 0.5rem 0.08rem;
  }
  .vis i { font-style: normal; }
  .vis.immediate { background: var(--held); color: var(--paper); }
  .vis.delayed { background: var(--tally-wash); color: var(--ink); box-shadow: inset 0 0 0 var(--lw-thin) var(--tally); }
  .vis.invisible { background: var(--tally); color: var(--paper); }
  .conseq { display: block; margin-top: 0.4rem; }

  .legend {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.35rem; align-items: center;
    padding: 0.75rem 1rem; border-top: var(--lw-key) solid var(--draft-ink);
    background: var(--draft-panel);
    font-family: var(--f-mono); font-weight: 500; font-size: 0.625rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--draft-ink);
  }
  .legend > span { display: flex; align-items: center; gap: 0.4rem; }
  .lg-bar {
    width: 22px; height: 8px; border-radius: 0;
    border: var(--lw-thin) solid var(--draft-ink);
  }
  .lg-ico { flex: none; }
  .lg-sep { width: var(--lw-thin); height: 14px; background: var(--draft-ink); }

  /* The readout is a callout card: vellum, object keyline. */
  .detail {
    background: var(--surface); border: var(--lw-key) solid var(--ink);
    padding: 1.35rem 1.5rem 1.5rem;
  }
  .panel { display: flex; flex-direction: column; gap: 0.9rem; }

  .detail-head { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: baseline; }
  .detail-head h3 { font-size: 1.25rem; margin-right: auto; }

  .detail-what { font-size: 1.0625rem; line-height: 1.5; max-width: 60ch; }

  /* Two-column translation table, at dimension weight. */
  .xlate { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.55rem 1.25rem; margin: 0; }
  .xlate dt {
    font-family: var(--f-mono); font-weight: 500; font-size: 0.6875rem;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-mid);
    padding-top: 0.18rem;
  }
  .xlate dd { margin: 0; color: var(--ink-mid); font-size: 0.9375rem; line-height: 1.55; max-width: 58ch; }
  .xlate dd :global(strong) { color: var(--ink); font-weight: 500; }

  @media (max-width: 34rem) {
    .xlate { grid-template-columns: 1fr; gap: 0.15rem; }
    .xlate dd { margin-bottom: 0.7rem; }
  }
</style>
