---
/**
 * Summary + experience under the lens switcher.
 *
 * Every lens variant is rendered server-side and hidden with [hidden]; the
 * script only flips which one is visible. That keeps the default lens fully
 * readable without JavaScript, and means no data is duplicated into a script
 * tag just to be re-rendered on the client.
 */
import { lenses, defaultLens } from "../data/lenses";
import { roles } from "../data/experience";
---
<div class="lens">
  <div class="wrap lens-inner">
    <span class="label" id="lens-label">Read this as a candidate for</span>
    <div class="lens-row" role="group" aria-labelledby="lens-label">
      {lenses.map((l) => (
        <button
          class="lens-btn plate-btn"
          type="button"
          data-lens={l.id}
          aria-pressed={l.id === defaultLens ? "true" : "false"}
        >{l.label}</button>
      ))}
    </div>
  </div>
</div>

<section class="section" style="border-top: 0;">
  <div class="wrap section-grid">
    <div class="label">Summary</div>
    <div class="section-body">
      {lenses.map((l) => (
        <p class="summary" data-lens-panel={l.id} hidden={l.id !== defaultLens} set:html={l.summary} />
      ))}
    </div>
  </div>
</section>

<section class="section" id="experience">
  <div class="wrap section-grid">
    <div class="label">Experience</div>
    <div class="section-body">
      <ul class="jobs">
        {roles.map((role) => (
          <li data-current={role.current ? "" : null}>
            <span class="years">{role.years}</span>
            <h3>{role.title}</h3>
            {role.org && <span class="org">{role.org}</span>}
            {role.note && <p class="note-line">{role.note}</p>}
            {role.lensKey && lenses.map((l) => (
              <ul class="bullets" data-lens-panel={l.id} hidden={l.id !== defaultLens}>
                {l[role.lensKey!].map((b) => <li>{b}</li>)}
              </ul>
            ))}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".lens-btn");
  const panels = document.querySelectorAll<HTMLElement>("[data-lens-panel]");

  function setLens(id: string) {
    panels.forEach((p) => { p.hidden = p.dataset.lensPanel !== id; });
    buttons.forEach((b) => {
      b.setAttribute("aria-pressed", b.dataset.lens === id ? "true" : "false");
    });
  }

  buttons.forEach((b) => {
    b.addEventListener("click", () => setLens(b.dataset.lens!));
  });
</script>

<style>
  /* Control strip — newsprint panel, keyline, sitting in the sheet gutter
     above the first plate. */
  .lens {
    padding: var(--plate-gap) clamp(0.625rem, 2.4vw, 1.375rem) 0;
  }
  .lens-inner {
    background: var(--sunk); color: var(--ink);
    border: var(--lw-key) solid var(--ink);
    box-shadow: var(--lamp);
    padding: 1rem var(--plate-pad) 1.1rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .lens-inner > .label { color: var(--ink-mid); }
  .lens-row { display: flex; flex-wrap: wrap; gap: 0.75rem 0.7rem; }

  /* .plate-btn in brand.css carries the keyline, the hard offset and the
     press behaviour. Only the pressed fill is stated here. */
  .lens-btn[aria-pressed="true"] { background: var(--tally); color: var(--paper); }

  .summary { font-size: 1.1875rem; line-height: 1.5; font-weight: 400; max-width: 56ch; }
  .summary :global(em) { font-style: normal; box-shadow: inset 0 -0.4em 0 var(--tally-wash); }

  /* The career is a run: a keyline with stations on it. Square, because the
     system has no corner radius — the tally lamp is the only round object. */
  .jobs {
    list-style: none; margin: 0; padding: 0 0 0 1.6rem;
    border-left: var(--lw-key) solid var(--ink);
    display: flex; flex-direction: column; gap: 2rem;
  }
  .jobs li { position: relative; }
  .jobs li::before {
    content: ""; position: absolute; left: calc(-1.6rem - 6.25px); top: 0.52rem;
    width: 9px; height: 9px;
    background: var(--paper); border: var(--lw-key) solid var(--ink);
  }
  .jobs li[data-current]::before { background: var(--tally); }

  .years {
    font-family: var(--f-mono); font-weight: 500; font-size: 0.6875rem;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-mid);
    font-variant-numeric: tabular-nums; display: block; margin-bottom: 0.28rem;
  }
  .org {
    font-family: var(--f-mono); font-weight: 500; font-size: 0.75rem;
    color: var(--tally); letter-spacing: 0.08em; text-transform: uppercase;
    display: block; margin-top: 0.3rem;
  }

  /* Leader ticks at dimension weight. */
  .bullets {
    margin: 0.8rem 0 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .bullets li { position: relative; padding-left: 1.05rem; color: var(--ink-mid);
                font-size: 0.9688rem; line-height: 1.55; max-width: 62ch; }
  .bullets li::before {
    content: ""; position: absolute; left: 0; top: 0.66em;
    width: 7px; height: var(--lw-med); background: var(--tally);
  }
  .bullets li::marker { content: none; }

  .note-line { margin-top: 0.65rem; color: var(--ink-mid); font-size: 0.9688rem; max-width: 62ch; }
</style>
