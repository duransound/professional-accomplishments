  .tblock { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 2fr); background: var(--surface); border-bottom: var(--lw-key) solid var(--ink); }
  .tblock > div { padding: 0.45rem 0.75rem; display: flex; flex-direction: column; gap: 0.1rem; border-right: var(--lw-thin) solid var(--ink); min-width: 0; }
  .tblock > div:last-child { border-right: 0; }
  .tblock span { font-family: var(--f-mono); font-weight: 500; font-size: 0.5rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mid); }
  .tblock b { font-family: var(--f-display); font-size: 0.8125rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tblock b.m { font-family: var(--f-mono); font-weight: 500; font-size: 0.6875rem; }
  .screen { padding: 1rem 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
