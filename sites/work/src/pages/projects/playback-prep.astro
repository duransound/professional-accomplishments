  .s-h { font-size: 1.375rem; letter-spacing: -0.02em; }
  .s-h span { font-family: var(--f-mono); font-weight: 500; font-size: 0.75rem; color: var(--tally); margin-right: 0.3rem; vertical-align: 0.2em; }
  .win-status {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem 1rem; padding: 0.45rem 0.75rem;
    border-top: var(--lw-key) solid var(--ink); background: var(--sunk);
    font-family: var(--f-mono); font-weight: 500; font-size: 0.5625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mid);
  }

  /* ---- ingest ---- */
