  .intake label { display: flex; flex-direction: column; gap: 0.3rem; }
  .intake label.grow { flex: 1 1 14rem; }
  .intake label > span { font-family: var(--f-mono); font-weight: 500; font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mid); }
  .intake input, .intake select {
    height: 2.6rem; border: var(--lw-med) solid var(--ink); background: var(--paper); color: var(--ink);
    font-family: var(--f-mono); font-size: 0.75rem; padding: 0 0.6rem; border-radius: 0; min-width: 0;
  }
  .intake input:focus-visible, .intake select:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  .plate-btn.on { background: var(--tally); color: var(--paper); }
